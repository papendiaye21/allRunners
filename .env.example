# Copy this file to ".env" and fill in your real key.
# Do not share or commit the ".env" file.

ALLRUNNERS_API_KEY=

# Optional — any third-party service (maps, weather, AI, etc.)
SERVICE_API_KEY=

# Legacy name (still read if SERVICE_API_KEY is empty)
OPENAI_API_KEY=

# Smashrun OAuth (code flow)
SMASHRUN_CLIENT_ID=
SMASHRUN_CLIENT_SECRET=

# Optional: exact site origin you use in the browser (no path). Fixes redirect_uri if
# localhost vs 127.0.0.1 would otherwise mismatch. Must match Smashrun redirect URI registration.
# Example: ALLRUNNERS_PUBLIC_ORIGIN=http://127.0.0.1:5005
ALLRUNNERS_PUBLIC_ORIGIN=
